# ---------------------------------------------------------------
# AI-ASSISTED-PROGRAMMING-PROJECTS — ignore rules
#
# Goal: keep the repository full of SOURCE (scripts, tools, models)
# and free of machine-generated output that bloats it.
# ---------------------------------------------------------------

# --- Python cache and local runtime files ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# --- PyInstaller / packaged executables ---
# Share the source, not the compiled binary. A built .exe is large,
# unreviewable, and flagged as unsafe by most browsers and AV tools.
build/
build_tools/
dist/
*.exe
*.spec
*.toc
*.pkg
*.pyz
base_library.zip
xref-*.html
warn-*.txt

# --- Local app data created by participant apps ---
data/
server.log
server.out.log

# --- STAAD.Pro generated output and recovery files ---
# Keep the .std model (it is the real work); drop what STAAD
# regenerates from it on open/analyse.
*.App.log
*.cod
*.cut
*.err
*.sbk
*.slg
*.std.metadata
*.uid
*.REI_Saved_Picture
*.REI_SPRO_Auxilary_Data
*_AutoRecovery.zip

# STAAD preview thumbnails (200x140 .png written beside each .std model).
# These are ignored by FOLDER, not by extension, so that genuine output
# -- plots, drawing sheets, screenshots -- can still be committed normally.
**/*STAAD*/*.png
**/*staad*/*.png
**/Std Model/*.png
**/STD MODEL/*.png

# Two strays that sit directly in a participant folder rather than a
# STAAD subfolder (same 200x140 thumbnails, same reason):
1. FEBRUARY 14 - 15/LANTICSE/trial.png
3. MARCH 14-15/LUCERO/Structure1.png

# NOTE: *.png is deliberately NOT blanket-ignored. Participants commit real
# images -- e.g. 3. MARCH 14-15/Nsultan/nscp_building_design.png is a
# 3930x4830 structural drawing sheet generated by that participant's script.
# Ignoring all .png would silently drop work like that.

# --- Editor and OS noise ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
